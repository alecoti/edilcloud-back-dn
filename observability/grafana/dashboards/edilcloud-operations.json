{
  "title": "EdilCloud Operations",
  "uid": "edilcloud-operations",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "type": "stat",
      "title": "Host CPU busy",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        { "expr": "100 - (avg by(instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)", "legendFormat": "{{instance}}" }
      ],
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 }
    },
    {
      "type": "stat",
      "title": "Host memory used",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        { "expr": "(1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)) * 100", "legendFormat": "{{instance}}" }
      ],
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 }
    },
    {
      "type": "stat",
      "title": "Disk used",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        { "expr": "(1 - (node_filesystem_avail_bytes{mountpoint=\"/\"} / node_filesystem_size_bytes{mountpoint=\"/\"})) * 100", "legendFormat": "{{instance}}" }
      ],
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 0 }
    },
    {
      "type": "stat",
      "title": "Public health",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        { "expr": "probe_success", "legendFormat": "{{instance}}" }
      ],
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 0 }
    },
    {
      "type": "timeseries",
      "title": "Backend p95 by route",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        { "expr": "edilcloud_timing_p95_milliseconds{name=\"http.request.duration\"}", "legendFormat": "{{method}} {{path}}" }
      ],
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 6 }
    },
    {
      "type": "timeseries",
      "title": "Container memory",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        { "expr": "container_memory_working_set_bytes{name!=\"\"}", "legendFormat": "{{name}}" }
      ],
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 6 }
    },
    {
      "type": "timeseries",
      "title": "HTTP requests",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        { "expr": "increase(edilcloud_counter_total{name=\"http.requests\"}[5m])", "legendFormat": "{{method}} {{path}} {{status}}" }
      ],
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 15 }
    },
    {
      "type": "logs",
      "title": "Recent container logs",
      "datasource": { "type": "loki", "uid": "Loki" },
      "targets": [
        { "expr": "{container_name=~\"back-dn-.*\"}" }
      ],
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 15 }
    }
  ]
}
